{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/tienda", "destination": "/index.html" },
    { "source": "/carrito", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/producto/:path*", "destination": "/index.html" },
    { "source": "/gracias/:path*", "destination": "/index.html" }
  ]
}
